# Generic template: every variable the app uses, with REPLACE_ME placeholders.
# Copy to .env.local and fill in for local dev (Supabase values come from
# `pnpm supabase status` after `pnpm supabase:start`).
#
# Production/preview values live in Vercel env vars — see .env.cloud.example
# and docs/ENVIRONMENTS.md.

# ── App ───────────────────────────────────────────────────────────────
# Single dev origin = localhost (see docs/ENVIRONMENTS.md).
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# ── Supabase ──────────────────────────────────────────────────────────
# Local values from `pnpm supabase:start`. Cloud values from the dashboard.
# Service-role key is SERVER-ONLY — never NEXT_PUBLIC.
NEXT_PUBLIC_SUPABASE_URL=REPLACE_ME
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME

# ── Google OAuth (Supabase Auth provider) ────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# (Web application). Locally the Supabase CLI reads these to wire
# [auth.external.google] in supabase/config.toml. In the cloud, configure
# Google in the Supabase Dashboard instead.
GOOGLE_CLIENT_ID=REPLACE_ME
GOOGLE_CLIENT_SECRET=REPLACE_ME

# ── Anthropic ─────────────────────────────────────────────────────────
# Model IDs are configuration, never hard-coded (INITIAL_PROMPT.md §4).
# Verified 2026-09-02 against the Anthropic models overview (docs/PLAN.md §2):
#   fast      = claude-sonnet-5  (page classification, Nick router)
#   reasoning = claude-opus-5    (extraction, Nick answers)
ANTHROPIC_API_KEY=REPLACE_ME
ANTHROPIC_FAST_MODEL=claude-sonnet-5
ANTHROPIC_REASONING_MODEL=claude-opus-5

# ── Jobs ──────────────────────────────────────────────────────────────
# Bearer token Vercel Cron sends to /api/jobs/process-documents (Phase 2).
# Generate with: openssl rand -hex 32
CRON_SECRET=REPLACE_ME
