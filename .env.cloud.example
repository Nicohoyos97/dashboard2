# Cloud credentials for reference. Paste real values into Vercel environment
# variables (Project → Settings → Environment Variables), NOT into a local
# file. Never put the real service_role here — this template is committed.
#
# Only the variables that DIFFER between local and cloud (the Supabase
# instance). Everything else (ANTHROPIC_*, GOOGLE_*) is in .env.example.
# The Dashboard 2.0 cloud project must be created first — docs/ENVIRONMENTS.md.

# ── App ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://app.hoyosbaker.com
APP_URL=https://app.hoyosbaker.com

# ── Supabase (cloud project) ──────────────────────────────────────────
# URL: Dashboard → Project Settings → API → Project URL (subdomain = project ref).
NEXT_PUBLIC_SUPABASE_URL=https://<REPLACE_ME>.supabase.co

# anon (publishable) key: Dashboard → Project Settings → API → "anon" "public".
NEXT_PUBLIC_SUPABASE_ANON_KEY=PASTE_PROJECT_ANON_KEY

# service_role key: SERVER-ONLY. Password manager → Vercel env vars. Never commit.
SUPABASE_SERVICE_ROLE_KEY=PASTE_FROM_VAULT

# ── Google OAuth (cloud) ──────────────────────────────────────────────
# NOT configured via env vars in the cloud: Supabase Dashboard → Authentication →
# Providers → Google (same Client ID/Secret as local) and add
# https://<ref>.supabase.co/auth/v1/callback in Google Cloud Console.
